@{
    Layout = null;
    ViewData["Title"] = "Mauno POS — Simple Tills for SA Shops";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mauno POS — Simple Tills for SA Shops</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --blue:     #4f63f5;
      --blue-dark:#3a4fd4;
      --cyan:     #3db8e8;
      --white:    #ffffff;
      --offwhite: #f5f6ff;
      --text:     #111;
      --muted:    #555;
      --card-radius: 14px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--offwhite);
      color: var(--text);
      overflow-x: hidden;
    }

    /* ── HERO / NAVBAR ── */
    .hero {
      background: var(--blue);
      padding: 0 0 60px;
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: '';
      position: absolute;
      bottom: -2px; left: 0; right: 0;
      height: 50px;
      background: var(--offwhite);
      border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    }

    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 60px;
    }

    .nav-logo {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--white);
      letter-spacing: -0.02em;
    }

    .nav-login {
      color: var(--white);
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      padding: 10px 24px;
      border: 2px solid rgba(255,255,255,0.6);
      border-radius: 999px;
      transition: background 0.2s, border-color 0.2s;
    }
    .nav-login:hover { background: rgba(255,255,255,0.15); border-color: #fff; }

    .hero-text {
      text-align: center;
      padding: 30px 20px 10px;
      opacity: 0;
      transform: translateY(24px);
    }

    .hero-text h1 {
      font-size: clamp(2.8rem, 7vw, 5rem);
      font-weight: 800;
      color: var(--white);
      letter-spacing: -0.03em;
      line-height: 1.05;
      margin-bottom: 14px;
    }

    .hero-text p {
      font-size: 1.1rem;
      color: rgba(255,255,255,0.80);
      max-width: 500px;
      margin: 0 auto;
    }

    .hero-cta {
      display: flex;
      gap: 14px;
      justify-content: center;
      margin-top: 32px;
    }

    .btn-white {
      background: var(--white);
      color: var(--blue);
      font-weight: 700;
      font-size: 0.95rem;
      padding: 14px 30px;
      border-radius: 999px;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 18px rgba(0,0,0,0.12);
    }
    .btn-white:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.18); }

    .btn-outline-white {
      background: transparent;
      color: var(--white);
      font-weight: 600;
      font-size: 0.95rem;
      padding: 14px 30px;
      border-radius: 999px;
      text-decoration: none;
      border: 2px solid rgba(255,255,255,0.6);
      transition: background 0.2s;
    }
    .btn-outline-white:hover { background: rgba(255,255,255,0.12); }

    /* ── SECTIONS ── */
    .section {
      padding: 72px 60px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 10px;
    }

    .section-title {
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      font-weight: 800;
      color: var(--text);
      margin-bottom: 40px;
      letter-spacing: -0.02em;
    }

    /* ── INFO CARDS (accordion style) ── */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .info-card {
      border-radius: var(--card-radius);
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0,0,0,0.07);
      opacity: 0;
      transform: translateY(28px);
      transition: box-shadow 0.25s, transform 0.25s;
    }

    .info-card:hover { box-shadow: 0 8px 28px rgba(79,99,245,0.18); transform: translateY(-3px); }

    .info-card-header {
      background: var(--blue);
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      user-select: none;
    }

    .info-card-header h3 {
      color: var(--white);
      font-size: 1rem;
      font-weight: 700;
    }

    .info-card-icon {
      font-size: 1.3rem;
      transition: transform 0.3s;
    }

    .info-card-body {
      background: var(--white);
      padding: 20px 22px;
    }

    .info-card-body ul {
      list-style: disc;
      padding-left: 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .info-card-body li {
      font-size: 0.92rem;
      color: var(--text);
      line-height: 1.55;
    }

    /* ── PRICING SECTION ── */
    .pricing-section {
      background: var(--blue);
      position: relative;
      padding: 80px 60px;
      overflow: hidden;
    }

    .pricing-section::before {
      content: '';
      position: absolute;
      top: -2px; left: 0; right: 0;
      height: 50px;
      background: var(--offwhite);
      border-radius: 0 0 50% 50% / 0 0 100% 100%;
    }

    .pricing-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .pricing-title {
      text-align: center;
      font-size: clamp(1.6rem, 3.5vw, 2.4rem);
      font-weight: 800;
      color: var(--white);
      margin-bottom: 50px;
      letter-spacing: -0.02em;
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .pricing-card {
      border-radius: var(--card-radius);
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(0,0,0,0.18);
      opacity: 0;
      transform: translateY(30px);
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .pricing-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(0,0,0,0.28); }

    .pricing-card-header {
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(8px);
      padding: 18px 24px;
      text-align: center;
      border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .pricing-card-header h3 {
      color: var(--white);
      font-size: 1.1rem;
      font-weight: 700;
    }

    .pricing-card-body {
      background: rgba(255,255,255,0.92);
      padding: 24px 24px 0;
    }

    .pricing-card-body ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 0;
    }

    .pricing-card-body li {
      font-size: 0.9rem;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pricing-card-body li::before {
      content: '✓';
      color: var(--blue);
      font-weight: 700;
      flex-shrink: 0;
    }

    .pricing-price {
      background: rgba(255,255,255,0.92);
      padding: 20px 24px 24px;
      text-align: center;
    }

    .pricing-amount {
      font-size: 2rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.02em;
    }

    .pricing-period {
      font-size: 0.85rem;
      color: var(--muted);
      margin-top: 2px;
    }

    .pricing-card.featured .pricing-card-header { background: rgba(255,255,255,0.25); }
    .pricing-card.featured .pricing-amount { color: var(--blue); }

    .pricing-cta-bar {
      margin-top: 50px;
      background: rgba(255,255,255,0.12);
      border-radius: 14px;
      padding: 22px 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .pricing-cta-bar span {
      color: var(--white);
      font-weight: 700;
      font-size: 1.05rem;
    }

    .pricing-cta-bar a {
      color: var(--white);
      font-weight: 600;
      text-decoration: underline;
      font-size: 1rem;
    }

    /* ── STATS BAR ── */
    .stats-bar {
      display: flex;
      justify-content: center;
      gap: 60px;
      padding: 48px 60px;
      background: var(--white);
      border-bottom: 1px solid rgba(0,0,0,0.06);
    }

    .stat-item { text-align: center; opacity: 0; transform: translateY(16px); }
    .stat-num {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--blue);
      letter-spacing: -0.02em;
    }
    .stat-lbl { font-size: 0.82rem; color: var(--muted); margin-top: 4px; font-weight: 500; }

    /* ── FOOTER ── */
    footer {
      background: var(--blue);
      color: rgba(255,255,255,0.75);
      text-align: center;
      padding: 28px 20px;
      font-size: 0.85rem;
    }

    footer strong { color: var(--white); }

    /* ── SCROLL REVEAL ── */
    .reveal { opacity: 0; transform: translateY(28px); }
    .reveal.visible { opacity: 1; transform: translateY(0); transition: opacity 0.5s ease, transform 0.5s ease; }

  </style>
  <style>
        /* ── RESPONSIVE ── */
        @@media (max-width: 900px) {
        .info-grid, .pricing-grid {
        grid-template-columns: 1fr 1fr;
        }

        .navbar {
        padding: 18px 24px;
        }

        .section {
        padding: 52px 24px;
        }

        .pricing-section {
        padding: 60px 24px;
        }

        .stats-bar {
        gap: 32px;
        flex-wrap: wrap;
        padding: 36px 24px;
        }
        }
        @@media (max-width: 580px) {
        .info-grid, .pricing-grid {
        grid-template-columns: 1fr;
        }

        .hero-cta {
        flex-direction: column;
        align-items: center;
        }
        }
  </style>
</head>
<body>

  <!-- ── HERO ── -->
  <div class="hero">
    <nav class="navbar">
      <div class="nav-logo">MAUNO</div>
      <a asp-controller="Auth" asp-action="Login" class="nav-login">Login / Sign Up</a>
    </nav>

    <div class="hero-text" id="heroText">
      <h1>Simple Tills,<br/>Built For SA.</h1>
      <p>Simple Tills, Local Support, Built For SA shops.</p>
      <div class="hero-cta">
        <a asp-controller="Auth" asp-action="Register" class="btn-white">Get Started Free</a>
        <a href="#what-we-offer" class="btn-outline-white">Learn More</a>
      </div>
    </div>
  </div>

  <!-- ── STATS ── -->
  <div class="stats-bar" id="statsBar">
    <div class="stat-item"><div class="stat-num" data-target="5">0</div><div class="stat-lbl">Shops Served</div></div>
    <div class="stat-item"><div class="stat-num" data-target="14">0</div><div class="stat-lbl">Day Free Trial</div></div>
    <div class="stat-item"><div class="stat-num" data-target="100%">0</div><div class="stat-lbl">Offline Ready</div></div>
    <div class="stat-item"><div class="stat-num" data-target="24/7">0</div><div class="stat-lbl">Client Support</div></div>
  </div>

  <!-- ── WHAT WE OFFER ── -->
  <section class="section" id="what-we-offer">
    <p class="section-label">What we offer</p>
    <h2 class="section-title">Everything your shop needs</h2>

    <div class="info-grid" id="infoGrid">

      <div class="info-card">
        <div class="info-card-header" data-toggle>
          <h3>What is MaunoPOS?</h3>
          <span class="info-card-icon">▾</span>
        </div>
        <div class="info-card-body">
          <ul>
            <li>MaunoPOS is an offline Point Of Sale System built for local businesses</li>
            <li>Works without internet — no WiFi, no problem</li>
            <li>Designed specifically for South African small businesses</li>
          </ul>
        </div>
      </div>

      <div class="info-card">
        <div class="info-card-header" data-toggle>
          <h3>How It Works?</h3>
          <span class="info-card-icon">▾</span>
        </div>
        <div class="info-card-body">
          <ul>
            <li>Manages your sales and allocate your expenses</li>
            <li>Stores your complete sales history</li>
            <li>Alerts you when products are out of stock</li>
            <li>Simple interface anyone can learn in minutes</li>
          </ul>
        </div>
      </div>

      <div class="info-card">
        <div class="info-card-header" data-toggle>
          <h3>Payment Methods</h3>
          <span class="info-card-icon">▾</span>
        </div>
        <div class="info-card-body">
          <ul>
            <li>Card and EFT payments through the MaunoPOS website</li>
            <li>Cash payments through the MaunoPOS App</li>
            <li>Instant payment confirmation and receipts</li>
          </ul>
        </div>
      </div>

      <div class="info-card">
        <div class="info-card-header" data-toggle>
          <h3>Security</h3>
          <span class="info-card-icon">▾</span>
        </div>
        <div class="info-card-body">
          <ul>
            <li>POPIA & SSL encryption on all data</li>
            <li>Role-based access — staff see only what they need</li>
            <li>Secure cloud backups of your sales data</li>
          </ul>
        </div>
      </div>

      <div class="info-card">
        <div class="info-card-header" data-toggle>
          <h3>Setup</h3>
          <span class="info-card-icon">▾</span>
        </div>
        <div class="info-card-body">
          <ul>
            <li>Feel free to contact us:</li>
            <li> maunopossa@yahoo.com</li>
            <li> Call / WhatsApp: 0648542912 / 0633336462</li>
            <li>We come to you for Premium installations</li>
          </ul>
        </div>
      </div>

      <div class="info-card">
        <div class="info-card-header" data-toggle>
          <h3>Cancellation</h3>
          <span class="info-card-icon">▾</span>
        </div>
        <div class="info-card-body">
          <ul>
            <li>Cancel anytime — no lock-in contracts</li>
            <li>No cancellation fees or hidden charges</li>
            <li>Your data remains accessible for 30 days after cancellation</li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- ── PRICING ── -->
  <div class="pricing-section" id="pricing">
    <div class="pricing-inner">
      <h2 class="pricing-title">No Wifi? No Problem. Mauno POS</h2>

      <div class="pricing-grid" id="pricingGrid">

        <div class="pricing-card">
          <div class="pricing-card-header"><h3>Trial</h3></div>
          <div class="pricing-card-body">
            <ul>
              <li>1 application licence</li>
              <li>14 Day Free Trial</li>
              <li>Customer Support</li>
              <li>Store Management</li>
            </ul>
          </div>
          <div class="pricing-price">
            <div class="pricing-amount">Free</div>
            <div class="pricing-period">14 days, no card required</div>
          </div>
        </div>

        <div class="pricing-card featured">
          <div class="pricing-card-header"><h3>Standard</h3></div>
          <div class="pricing-card-body">
            <ul>
              <li>2 application licences</li>
              <li>Limited updates</li>
              <li>Customer Support</li>
              <li>Store Management</li>
            </ul>
          </div>
          <div class="pricing-price">
            <div class="pricing-amount">R1200</div>
            <div class="pricing-period">per month</div>
          </div>
        </div>

        <div class="pricing-card">
          <div class="pricing-card-header"><h3>Premium</h3></div>
          <div class="pricing-card-body">
            <ul>
              <li>5 application licences</li>
              <li>Unlimited updates</li>
              <li>Customer Support</li>
              <li>Store Management</li>
              <li>Free Installation</li>
            </ul>
          </div>
          <div class="pricing-price">
            <div class="pricing-amount">R2000</div>
            <div class="pricing-period">per month</div>
          </div>
        </div>

      </div>

      <div class="pricing-cta-bar">
        <span> Send us a DM Now:</span>
        <a href="mailto:Maunopossa@yahoo.com">Maunopossa@yahoo.com</a>
        <span style="color:rgba(255,255,255,0.5);font-size:0.8rem;">· Terms &amp; Conditions apply</span>
      </div>
    </div>
  </div>

  <!-- ── FOOTER ── -->
  <footer>
    <strong>Mauno POS</strong> &mdash; Simple Tills, Local Support, Built For SA shops.<br/>
     0648542912 / 0633336462 &nbsp;|&nbsp;  maunopossa@yahoo.com
  </footer>

  <script>
  $(function () {

    // ── Hero text fade in ──
    setTimeout(function () {
      $('#heroText').animate({ opacity: 1 }, {
        duration: 600,
        step: function (now) { $(this).css('transform', 'translateY(' + (24 - now * 24) + 'px)'); },
        complete: function () { $(this).css('transform', 'translateY(0)'); }
      });
    }, 150);

    // ── Info card accordion toggle ──
    $('[data-toggle]').on('click', function () {
      const $card  = $(this).closest('.info-card');
      const $body  = $card.find('.info-card-body');
      const $icon  = $card.find('.info-card-icon');
      const isOpen = $body.is(':visible');

      // Close all
      $('.info-card-body').slideUp(220);
      $('.info-card-icon').css('transform', 'rotate(0deg)');

      // Open clicked if it was closed
      if (!isOpen) {
        $body.slideDown(220);
        $icon.css('transform', 'rotate(180deg)');
      }
    });

    // ── Scroll reveal ──
    function revealOnScroll() {
      const winBottom = $(window).scrollTop() + $(window).height();

      // Info cards
      $('#infoGrid .info-card:not(.revealed)').each(function (i) {
        if ($(this).offset().top < winBottom - 60) {
          const $el = $(this);
          const delay = i * 80;
          setTimeout(function () {
            $el.addClass('revealed');
            $el.animate({ opacity: 1 }, {
              duration: 400,
              step: function (now) { $(this).css('transform', 'translateY(' + (28 - now * 28) + 'px)'); },
              complete: function () { $(this).css('transform', ''); }
            });
          }, delay);
        }
      });

      // Pricing cards
      $('#pricingGrid .pricing-card:not(.revealed)').each(function (i) {
        if ($(this).offset().top < winBottom - 40) {
          const $el = $(this);
          const delay = i * 120;
          setTimeout(function () {
            $el.addClass('revealed');
            $el.animate({ opacity: 1 }, {
              duration: 450,
              step: function (now) { $(this).css('transform', 'translateY(' + (30 - now * 30) + 'px)'); },
              complete: function () { $(this).css('transform', ''); }
            });
          }, delay);
        }
      });

      // Stats bar
      $('#statsBar .stat-item:not(.revealed)').each(function (i) {
        if ($(this).offset().top < winBottom - 40) {
          const $el = $(this);
          const target = parseInt($el.find('.stat-num').data('target'));
          const delay = i * 100;
          setTimeout(function () {
            $el.addClass('revealed');
            $el.animate({ opacity: 1 }, {
              duration: 300,
              step: function (now) { $(this).css('transform', 'translateY(' + (16 - now * 16) + 'px)'); },
              complete: function () { $(this).css('transform', ''); }
            });
            // Count up animation
            $({ count: 0 }).animate({ count: target }, {
              duration: 1200,
              easing: 'swing',
              step: function () { $el.find('.stat-num').text(Math.ceil(this.count)); },
              complete: function () { $el.find('.stat-num').text(target); }
            });
          }, delay);
        }
      });
    }

    $(window).on('scroll', revealOnScroll);
    revealOnScroll();

  });
  </script>

</body>
</html>
