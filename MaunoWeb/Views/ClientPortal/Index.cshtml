    </main>
  </div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  @if (TempData["Success"] != null)
  {
    <script>$(function(){ showToast('@TempData["Success"]'); });</script>
  }

  <script>
    $(function () {

      // ── Stat cards animate in ──
      $('.stat-card').each(function (i) {
        const $c = $(this);
        setTimeout(function () {
          $c.animate({ opacity: 1 }, {
            duration: 350,
            step: function (now) { $c.css('transform', 'translateY(' + (18 - now * 18) + 'px)'); },
            complete: function () { $c.css('transform', 'translateY(0)'); }
          });
        }, i * 90);
      });

      // ── Sidebar navigation ──
      $('.sidebar-btn').on('click', function () {
        const section = $(this).data('section');
        $('.sidebar-btn').removeClass('active');
        $(this).addClass('active');
        $('.page-section').removeClass('active');
        $('#section-' + section).addClass('active');
      });

      // ── Quick ticket button on overview ──
      $('#btn-quick-ticket').on('click', function () {
        $('.sidebar-btn[data-section="tickets"]').trigger('click');
        setTimeout(function () {
          $('html, body').animate({ scrollTop: $('#ticket-form-card').offset().top - 80 }, 400);
        }, 100);
      });

      // ── Toast ──
      window.showToast = function (msg) {
        $('#toast').text('✓ ' + msg).fadeIn(200);
        setTimeout(function () { $('#toast').fadeOut(400); }, 3000);
      };

    });
  </script>

</body>
</html>
