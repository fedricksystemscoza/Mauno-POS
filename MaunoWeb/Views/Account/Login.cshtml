```cshtml
@{
    ViewData["Title"] = "Login";
}


<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Inter', sans-serif;
        background: #000;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        background: #a8a8a8;
        border-radius: 18px;
        width: 620px;
        padding: 60px 50px 48px;
        display: flex;
        flex-direction: column;
        align-items: center;
        opacity: 0;
        transform: scale(0.96);
    }

    .input-wrap {
        width: 100%;
        margin-bottom: 20px;
    }

    .input-wrap input {
        width: 100%;
        background: white;
        border: none;
        border-radius: 999px;
        padding: 22px 32px;
        font-size: 1rem;
        outline: none;
    }

    .login-links {
        margin-top: 32px;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .link-forgot {
        color: #4B6FFF;
        text-decoration: none;
    }

    .link-signup {
        color: black;
        text-decoration: none;
    }

    .error-msg {
        color: #c0392b;
        min-height: 20px;
    }
</style>

<div class="login-card" id="loginCard">

        <form asp-controller="Auth" asp-action="Login" method="post" style="width:100%;">

            <div class="input-wrap">
                <input type="text"
                       name="Username"
                       id="username"
                       placeholder="Username"
                       autocomplete="username" />
            </div>

            <div class="input-wrap">
                <input type="password"
                       name="Password"
                       id="password"
                       placeholder="Password"
                       autocomplete="current-password" />
            </div>

            <div class="error-msg @(ViewBag.ErrorMessage != null ? "show" : "")">
                @ViewBag.ErrorMessage
            </div>

            <button type="submit" class="btn-login">Login</button>

        </form>

    <div class="login-links">
        <a asp-controller="Auth" asp-action="ForgotPassword" class="link-forgot">Forgot Password?</a>
        <a asp-controller="Auth" asp-action="Register" class="link-signup">Sign Up</a>
    </div>

</div>

@section Scripts
{
    <script>
        $(function () {

            $('#loginCard').delay(100).animate({ opacity: 1 }, {
                duration: 400,
                step: function (now) {
                    const scale = 0.96 + (now * 0.04);
                    $(this).css('transform', 'scale(' + scale + ')');
                },
                complete: function () {
                    $(this).css('transform', 'scale(1)');
                    $('#username').focus();
                }
            });

        });
    </script>
}
```

