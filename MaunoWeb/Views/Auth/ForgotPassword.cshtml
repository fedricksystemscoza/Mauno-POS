@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mauno POS — Forgot Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: #000;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: #a8a8a8;
            border-radius: 18px;
            width: 620px;
            padding: 50px 50px 44px;
            display: flex;
            flex-direction: column;
            align-items: center;
            opacity: 0;
            transform: scale(0.96);
        }

        .card-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 8px;
            text-align: center;
        }

        .card-subtitle {
            font-size: 0.9rem;
            color: #333;
            text-align: center;
            margin-bottom: 28px;
            line-height: 1.5;
        }

        .input-wrap {
            width: 100%;
            margin-bottom: 16px;
        }

        .input-wrap input {
            width: 100%;
            background: #fff;
            border: none;
            border-radius: 999px;
            padding: 20px 32px;
            font-size: 0.95rem;
            font-family: 'Inter', sans-serif;
            color: #111;
            outline: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            transition: box-shadow 0.2s;
        }

        .input-wrap input::placeholder { color: #555; }
        .input-wrap input:focus {
            box-shadow: 0 0 0 3px rgba(100,120,255,0.25), 0 2px 8px rgba(0,0,0,0.08);
        }

        .btn-submit {
            display: block;
            width: 100%;
            padding: 18px;
            margin-top: 6px;
            background: linear-gradient(135deg, #4B6FFF, #3db8e8);
            border: none;
            border-radius: 999px;
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            cursor: pointer;
            box-shadow: 0 4px 18px rgba(75,111,255,0.35);
            transition: opacity 0.2s, transform 0.15s;
        }

        .btn-submit:hover { opacity: 0.92; transform: translateY(-2px); }
        .btn-submit:active { transform: translateY(0); }

        .error-msg {
            color: #c0392b;
            font-size: 0.85rem;
            text-align: center;
            margin: 8px 0 4px;
            min-height: 20px;
            font-weight: 500;
        }

        .success-msg {
            background: rgba(34,197,94,0.15);
            border: 1px solid rgba(34,197,94,0.4);
            color: #166534;
            border-radius: 12px;
            padding: 14px 20px;
            font-size: 0.9rem;
            text-align: center;
            margin-bottom: 16px;
            width: 100%;
            display: none;
        }

        .back-link {
            margin-top: 20px;
            text-align: center;
        }

        .back-link a {
            font-size: 0.95rem;
            text-decoration: none;
            color: #111;
        }

        .back-link a span { color: #4B6FFF; }
        .back-link a:hover { text-decoration: underline; }

        @@media (max-width: 660px) {
            .card { width: 94vw; padding: 36px 20px 32px; }
        }
    </style>
</head>
<body>

    <div class="card" id="forgotCard">

        <div class="card-title">Forgot Password?</div>
        <div class="card-subtitle">
            Enter your username and email address.<br/>
            Your password will be reset by an administrator.
        </div>

        <div class="success-msg" id="successMsg">
            ✓ Request submitted. Please contact your administrator to complete the reset.
        </div>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post" style="width:100%;" id="forgotForm">
            @Html.AntiForgeryToken()

            <div class="input-wrap">
                <input type="text"
                       name="Username"
                       placeholder="Username"
                       autocomplete="username" />
            </div>

            <div class="input-wrap">
                <input type="email"
                       name="Email"
                       placeholder="Email Address"
                       autocomplete="email" />
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="error-msg">@ViewBag.ErrorMessage</div>
            }
            else
            {
                <div class="error-msg"></div>
            }

            <button type="submit" class="btn-submit">Reset Password</button>

        </form>

        @if (ViewBag.Success != null)
        {
            <script>
                $(function () { $('#successMsg').show(); $('#forgotForm').hide(); });
            </script>
        }

        <div class="back-link">
            <a asp-controller="Auth" asp-action="Login">
                Back to <span>Login</span>
            </a>
        </div>

    </div>

    <script>
        $(function () {
            $('#forgotCard').delay(100).animate({ opacity: 1 }, {
                duration: 400,
                step: function (now) {
                    $(this).css('transform', 'scale(' + (0.96 + now * 0.04) + ')');
                },
                complete: function () { $(this).css('transform', 'scale(1)'); }
            });

            $('input').on('focus', function () {
                $(this).closest('.input-wrap').stop(true).animate({ marginBottom: '18px' }, 150);
            }).on('blur', function () {
                $(this).closest('.input-wrap').stop(true).animate({ marginBottom: '16px' }, 150);
            });
        });
    </script>

</body>
</html>
